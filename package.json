{
  "name": "@powerchain-protocol/powerpay-checkout-sdk",
  "version": "1.0.0-beta.1",
  "private": false,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    ".env.example",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "docs",
    "env",
    "packages",
    "program-ids.json",
    "public",
    "scripts/solana-pay.sh",
    "styles"
  ],
  "scripts": {
    "build": "npm run build:sdk",
    "build:sdk": "tsc -p tsconfig.json",
    "build:programs": "bash scripts/build-programs.sh",
    "check:programs": "cargo check --workspace",
    "format": "cargo fmt --all && prettier --write src tests scripts/*.mjs",
    "lint": "cargo clippy --workspace --all-targets -- -D warnings && tsc --noEmit",
    "test": "npm run test:sdk && npm run test:programs",
    "test:sdk": "vitest run",
    "test:programs": "cargo test --workspace",
    "test:localnet": "bash scripts/test-localnet.sh",
    "localnet": "bash scripts/localnet.sh",
    "deploy:localnet": "bash scripts/deploy-programs.sh localnet",
    "deploy:devnet": "bash scripts/deploy-programs.sh devnet",
    "deploy:mainnet": "bash scripts/deploy-programs.sh mainnet-beta",
    "program:ids": "node scripts/sync-program-ids.mjs",
    "solana-pay": "bash scripts/solana-pay.sh",
    "token:create:devnet": "tsx scripts/create-powerpay-token.ts --cluster devnet",
    "token:create:mainnet": "tsx scripts/create-powerpay-token.ts --cluster mainnet-beta",
    "token:inspect": "tsx scripts/inspect-powerpay-token.ts",
    "token:revoke-mint": "bash scripts/revoke-token-authority.sh mint",
    "token:revoke-freeze": "bash scripts/revoke-token-authority.sh freeze",
    "docs:check": "node scripts/check-doc-links.mjs",
    "metadata:validate": "node scripts/validate-metadata.mjs",
    "build:all": "npm run build:sdk && npm run app:build",
    "check": "npm run typecheck:sdk && npm run test:sdk && npm run metadata:validate && npm run docs:check && npm run api:validate",
    "release:dry-run": "npm pack --dry-run",
    "prepublishOnly": "npm run check",
    "env:init": "node scripts/init-env.mjs",
    "app:dev": "node scripts/run-vite-safe.mjs",
    "app:build": "npm run build --workspace @powerchain-protocol/powerpay-demo-app",
    "app:typecheck": "npm run typecheck --workspace @powerchain-protocol/powerpay-demo-app",
    "setup": "npm run cwd:check && npm install && npm run env:init",
    "build:sdk:offline": "tsc -p tsconfig.local-build.json",
    "typecheck:sdk": "tsc -p tsconfig.json --noEmit",
    "verify:sdk": "npm run build:sdk && npm run test:sdk",
    "verify:offline": "npm run build:sdk:offline && npm run metadata:validate && npm run docs:check",
    "deps:scripts": "pnpm ignored-builds",
    "doctor": "node scripts/doctor.mjs",
    "clean": "node scripts/clean.mjs",
    "build:typescript": "npm run build:sdk && npm run app:check",
    "typecheck": "npm run typecheck:sdk && npm run app:typecheck",
    "verify": "npm run typecheck && npm run test:sdk && npm run metadata:validate && npm run docs:check",
    "app:check": "npm run check --workspace @powerchain-protocol/powerpay-demo-app",
    "verify:payments": "npm run typecheck:sdk && npm run test:sdk",
    "api:validate": "node scripts/validate-openapi.mjs",
    "release:check": "npm run clean && npm run metadata:validate && npm run docs:check && npm run api:validate && npm run token:validate && npm run networks:validate && npm run contracts:sui:check && npm run typecheck:sdk && npm run test:sdk && npm run build:all",
    "check:beta": "npm run routes:validate && npm run solana:api:validate && npm run typecheck:sdk && npm run test:sdk && npm run metadata:validate && npm run docs:check && npm run api:validate",
    "db:generate": "prisma generate",
    "db:validate": "prisma validate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx database/seed.ts",
    "token:validate": "node scripts/validate-token-metadata.mjs",
    "contracts:sui:check": "node scripts/check-sui-contracts.mjs",
    "networks:validate": "node scripts/validate-networks.mjs",
    "deps:approve": "pnpm approve-builds",
    "deps:approve:all": "pnpm approve-builds --all",
    "db:deps": "node scripts/check-prisma-install.mjs",
    "db:check": "npm run db:deps && npm run db:generate && npm run db:validate && tsc -p tsconfig.prisma.json --noEmit",
    "typecheck:prisma": "npm run db:generate && tsc -p tsconfig.prisma.json --noEmit",
    "doctor:pnpm": "node scripts/check-pnpm-config.mjs",
    "styles:sync": "node scripts/sync-public-styles.mjs",
    "reports:organize": "node scripts/organize-reports.mjs",
    "package:validate": "node scripts/validate-package-contents.mjs",
    "prebuild": "npm run styles:sync",
    "prepack": "npm run styles:sync && npm run reports:organize && npm run package:validate",
    "imports:validate": "node scripts/validate-app-imports.mjs",
    "app:doctor": "npm run imports:validate && npm run app:typecheck",
    "exports:validate": "node scripts/validate-public-exports.mjs",
    "solana:types:validate": "node scripts/validate-solana-type-boundaries.mjs",
    "contracts:sui:test:structure": "node scripts/validate-sui-payment-tests.mjs",
    "routes:validate": "node scripts/validate-api-routes.mjs",
    "solana:api:validate": "node scripts/validate-solana-instruction-api.mjs",
    "cwd:check": "node scripts/check-current-directory.mjs",
    "install:clean": "npm run cwd:check && node scripts/clean-install.mjs && npm install",
    "dev": "node scripts/run-vite-safe.mjs",
    "version:validate": "node scripts/validate-beta1-version.mjs",
    "cors:validate": "node scripts/validate-cors.mjs",
    "dev:host": "node scripts/run-vite-safe.mjs --host 0.0.0.0",
    "dev:reset": "node scripts/reset-dev-state.mjs",
    "vite:launcher:validate": "node scripts/validate-safe-vite-launcher.mjs",
    "dev:doctor": "node scripts/dev-doctor.mjs",
    "install:scripts:review": "npm install-scripts ls",
    "app:startup:validate": "node scripts/validate-app-startup.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "^1.98.4",
    "@solana/spl-token": "^0.4.15",
    "@solana/spl-token-metadata": "^0.1.6",
    "@solana/pay": "^0.2.6",
    "bignumber.js": "^9.3.1",
    "@metaplex-foundation/umi": "^1.2.0",
    "@metaplex-foundation/umi-bundle-defaults": "^1.2.0",
    "@metaplex-foundation/mpl-token-metadata": "^3.4.0",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/wallet-adapter-wallets": "^0.19.37",
    "@coral-xyz/anchor": "^0.32.1",
    "axios": "^1.19.0",
    "bs58": "^6.0.0",
    "node-fetch": "^3.3.2",
    "qrcode": "^1.5.4",
    "@pythnetwork/hermes-client": "^3.1.0",
    "zod": "^4.0.17",
    "@prisma/client": "^7.7.0",
    "@prisma/adapter-pg": "^7.7.0",
    "pg": "^8.16.3",
    "@mysten/sui": "^2.22.0",
    "@mysten/dapp-kit-react": "^2.1.6",
    "@cetusprotocol/cetus-sui-clmm-sdk": "^5.4.0",
    "dotenv": "^17.4.2",
    "buffer": "^6.0.3"
  },
  "peerDependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/react": "^19.0.0",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "tsx": "^4.23.1",
    "@types/qrcode": "^1.5.5",
    "prisma": "^7.7.0",
    "@types/pg": "^8.15.5",
    "@vitejs/plugin-react": "^6.0.5",
    "vite": "^8.1.5"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./styles/powerpay.css",
    "./package.json": "./package.json",
    "./styles/powerpay.css": "./styles/powerpay.css"
  },
  "description": "PowerPay checkout SDK, wallet UI, PWA assets, Solana Pay integrations, and native Solana payment programs.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerchain-protocol/powerpay-checkout-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/powerchain-protocol/powerpay-checkout-sdk/issues"
  },
  "homepage": "https://github.com/powerchain-protocol/powerpay-checkout-sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "solana",
    "checkout",
    "payments",
    "token-2022",
    "solana-pay",
    "wallet-adapter",
    "powerpay",
    "powerchain"
  ],
  "workspaces": [
    "packages/sdk/powerpay/ui",
    "app"
  ],
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  }
}
