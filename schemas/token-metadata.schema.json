{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://powerpay.dev/schemas/token-metadata.schema.json",
  "title": "PowerPay token metadata",
  "type": "object",
  "required": [
    "name",
    "symbol",
    "description",
    "image",
    "decimals",
    "standard"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Relative or absolute JSON Schema reference for editor validation"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9]{2,12}$"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "image": {
      "type": "string",
      "minLength": 1
    },
    "decimals": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18
    },
    "standard": {
      "enum": [
        "spl",
        "token-2022"
      ]
    },
    "mint": {
      "type": "string"
    },
    "website": {
      "type": "string",
      "format": "uri"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "extensions": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
