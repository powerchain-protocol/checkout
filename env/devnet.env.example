# PowerPay SDK and application
VITE_POWERPAY_ENV=development
VITE_POWERPAY_API_URL=http://localhost:8787
VITE_POWERPAY_PUBLISHABLE_KEY=pk_test_replace_me

# Solana
VITE_SOLANA_CLUSTER=devnet
VITE_SOLANA_PROGRAM_ID=
VITE_POWERCHAIN_PROGRAM_ID=
VITE_SOLANA_RPC_URL=https://api.devnet.solana.com
VITE_SOLANA_WS_URL=wss://api.devnet.solana.com

# Helius — use server-side values for privileged APIs
VITE_HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_API_KEY=
HELIUS_RPC_URL=https://devnet.helius-rpc.com/?api-key=YOUR_HELIUS_API_KEY
HELIUS_WEBHOOK_SECRET=

# Pyth Hermes
VITE_PYTH_HERMES_URL=https://pyth.dourolabs.app/hermes
VITE_PYTH_SOL_USD_FEED_ID=
VITE_PYTH_USDC_USD_FEED_ID=
VITE_PYTH_EUR_USD_FEED_ID=
PYTH_API_KEY=
PYTH_MAX_PRICE_AGE_SECONDS=30

# Tokens
VITE_USDC_MINT=
VITE_PWRP_MINT=
VITE_PWRP_DECIMALS=6
VITE_PWRP_TOKEN_STANDARD=token-2022

# Merchant
VITE_MERCHANT_AUTHORITY=
VITE_MERCHANT_TREASURY=
VITE_MERCHANT_FEE_TREASURY=
VITE_MERCHANT_FEE_BPS=75

# Token metadata
PWRP_METADATA_URI=https://example.com/metadata.json
PWRP_NAME=PowerPay
PWRP_SYMBOL=PWRP

# Server secrets — never expose with VITE_ prefix
POWERPAY_SECRET_KEY=sk_test_replace_me
MERCHANT_SIGNER_PATH=

# Cluster-specific program IDs
VITE_POWERPAY_PROGRAM_ID_DEVNET=
VITE_POWERPAY_PROGRAM_ID_MAINNET=
VITE_POWERCHAIN_PROGRAM_ID_DEVNET=
VITE_POWERCHAIN_PROGRAM_ID_MAINNET=

# Cluster-specific mints
VITE_PWRP_MINT_DEVNET=
VITE_PWRP_MINT_MAINNET=
VITE_USDC_MINT_DEVNET=
VITE_USDC_MINT_MAINNET=

# RPC routing
VITE_SOLANA_RPC_PROVIDER=public
VITE_SOLANA_RPC_URL_DEVNET=https://api.devnet.solana.com
VITE_SOLANA_RPC_URL_MAINNET=https://api.mainnet-beta.solana.com
VITE_HELIUS_API_KEY=
VITE_HELIUS_RPC_URL_DEVNET=
VITE_HELIUS_RPC_URL_MAINNET=
