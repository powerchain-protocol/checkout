{
  "name": "@powerchain-protocol/powerpay-demo-app",
  "private": true,
  "version": "1.0.0-beta.1",
  "type": "module",
  "scripts": {
    "dev": "node ../scripts/run-vite-safe.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "pnpm typecheck && pnpm build",
    "clean": "node -e \"import('node:fs').then(({rmSync})=>rmSync('dist',{recursive:true,force:true}))\"",
    "dev:reset": "node ../scripts/reset-dev-state.mjs"
  },
  "dependencies": {
    "@powerchain-protocol/powerpay-checkout-sdk": "file:..",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "@radix-ui/react-icons": "^1.3.2",
    "@web3icons/react": "^4.1.17",
    "axios": "^1.19.0",
    "bs58": "^6.0.0",
    "@mysten/sui": "^2.22.0",
    "@mysten/dapp-kit-react": "^2.1.6"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  },
  "engines": {
    "node": ">=22.12.0 <25",
    "npm": ">=11.0.0"
  }
}
